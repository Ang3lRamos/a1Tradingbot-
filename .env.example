MT5_LOGIN=12345678
MT5_PASSWORD=
MT5_SERVER=NombreDelBroker-Demo
# Ruta al terminal64.exe del broker. Obligatoria si hay varios MT5 instalados (aquí: GNT y MetaQuotes).
MT5_PATH=

# Alpaca (bot de config/alpaca_rsi2.toml). Llaves de la cuenta de PRÁCTICA (paper): Dashboard > Paper > API Keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = cuenta de práctica. false = dinero real (el motor lo bloquea mientras allow_real_account = false).
ALPACA_PAPER=true
